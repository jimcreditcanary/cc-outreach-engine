SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (drafting, MEDDICC seeding, angle selection)
ANTHROPIC_API_KEY=

# Postmark (Broadcast stream for outreach, inbound for replies)
POSTMARK_SERVER_TOKEN=
POSTMARK_BROADCAST_STREAM=outreach
POSTMARK_FROM="Jim Fell <jim@mail.creditcanary.co.uk>"
POSTMARK_REPLY_TO=jimfell@creditcanary.co.uk
