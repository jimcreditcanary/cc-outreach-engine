# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (drafting, MEDDICC seeding, angle selection)
ANTHROPIC_API_KEY=

# Postmark (Broadcast stream for outreach, inbound for replies)
POSTMARK_SERVER_TOKEN=
POSTMARK_BROADCAST_STREAM=outreach
POSTMARK_FROM="Jim Fell <jim@mail.creditcanary.co.uk>"
POSTMARK_REPLY_TO=jimfell@creditcanary.co.uk
POSTMARK_INBOUND_WEBHOOK_SECRET=

# App auth gate (operator login). Unset = open (dev/preview).
APP_PASSWORD=
APP_SESSION_SECRET=
# Daily cron auth (Vercel Cron Bearer token)
CRON_SECRET=
# Warm-up start date (ISO) for the send ramp; cadence tunables
SEND_WARMUP_START_DATE=
CADENCE_COOLDOWN_DAYS=28
CADENCE_MAX_PER_COMPANY=1

# Sending guardrails (§8)
SEND_DAILY_CAP=50
SEND_WARMUP_RAMP=10,20,35,50
SEND_WINDOW_START=09
SEND_WINDOW_END=17
COMPLAINT_RATE_PAUSE_THRESHOLD=0.003

# ─── Workflow send channel ────────────────────────────────────────────────────
# How approved outreach/nurture drafts are sent:
#   unset / "postmark" → send via Postmark, mirror an email to the HS timeline.
#   "hubspot"          → send via HubSpot's transactional Single-Send API, so
#                        HubSpot applies native open/click tracking + timeline
#                        logging. Falls back to Postmark unless fully set up:
#     1. Buy the HubSpot Transactional Email add-on.
#     2. Build a transactional email in HubSpot's email tool with
#          subject: {{ custom.email_subject }}   body: {{ custom.email_html }}
#        and put its content id in HUBSPOT_TRANSACTIONAL_EMAIL_ID.
#     3. Add the `transactional-email` scope to the Private App token.
#     4. Connect/verify the sending domain in HubSpot (so the from address is allowed).
HS_SEND_CHANNEL=
HUBSPOT_TRANSACTIONAL_EMAIL_ID=
# Optional: pin a dated endpoint instead of the stable v3 path, e.g.
#   /marketing/transactional/2026-09/single-email/send
HUBSPOT_TRANSACTIONAL_SEND_PATH=

# ─── Lead instant-invite + chase ──────────────────────────────────────────────
# Go-live switch for the automatic "fancy a quick call?" email to new leads.
# While unset/false: no invite is sent and capture keeps the legacy auto-draft.
# Set to "true" to send invites instantly on capture + chase at 48h / 7 days.
LEAD_INVITE_ENABLED=
# Booking link shared in the invite (defaults to Jim's HubSpot meetings page).
LEAD_INVITE_MEETINGS_URL=https://meetings-eu1.hubspot.com/jim-fell

# ─── Merchant onboarding ──────────────────────────────────────────────────────
# Companies House REST API key (free: developer.company-information.service.gov.uk).
# Already live in Vercel as COMPANIES_HOUSE_API. When unset, the CH adapter uses
# its fixture mock so the wizard still runs.
COMPANIES_HOUSE_API=
# Force integration adapters to their mocks: "all", or a comma list of names
# (companiesHouse,cop,callValidate,postcoder,drive,charityCommission,sanctions,fcaRegister).
# Any adapter also auto-mocks when its own credential is missing.
INTEGRATIONS_MOCK=
# Public merchant-form host. Defaults to the app host (serves /m/<token>); set
# to the branded host once its DNS + host-routing are live, e.g.
# https://onboarding.creditcanary.co.uk
ONBOARDING_FORM_BASE_URL=
# The internal API-sandbox endpoint (/api/internal/api-onboarding) is guarded by
# the existing CRON_SECRET bearer — no new secret needed.

# ─── Merchant onboarding · P3b payments ───────────────────────────────────────
# REQUIRED before merchants with payment products submit — AES-256-GCM key for
# bank sort codes + account numbers at rest. 32 bytes as hex (64) or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No key → the form refuses to store bank details (never plaintext).
ENCRYPTION_KEY=
# Confirmation of Payee PSP (Modulr / ClearBank / Form3 — TBC). Until both are
# set the CoP adapter mocks; a real check records "unavailable" if unconfigured.
COP_PROVIDER=
COP_API_KEY=
# Allies Postcoder address lookup (powers postcode → address on the form).
# Unset → fixture mock.
POSTCODER_API_KEY=
#
# ─── Merchant onboarding · P4 UBO checks ──────────────────────────────────────
# Call Validate (TransUnion) ID&V + PEP/sanctions screening. The live TransUnion
# contract isn't wired yet, so the adapter mocks until BOTH are set (and the
# live client still needs the API contract added). Unset → fixture mock.
CALL_VALIDATE_USER=
CALL_VALIDATE_PASSWORD=
#
# Later phases (provision ahead if you like; all mock until set):
#   FCA_REGISTER_API_KEY=            # P2 — FCA Register (free)
#   CHARITY_COMMISSION_API_KEY=      # P2 — Charity Commission register (free)
#   GOOGLE_SERVICE_ACCOUNT_JSON= ONBOARDING_DRIVE_ROOT_FOLDER_ID=  # P5 — Drive
